/*
 * -------------------------------------------------
 *  Nextflow config file for running tests
 * -------------------------------------------------
 * Defines bundled input files and everything required
 * to run a fast and simple test. Use as follows:
 *   nextflow run nf-core/airrflow -profile test_genotyping_mixed,<docker/singularity>
 */

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test mixed IG+TR genotyping'
    config_profile_description = 'Test dataset with one subject carrying both IG and TR loci to check mixed-locus genotyping'

    // Input data
    mode = 'assembled'

    // Samplesheet (and TR fixture) live on the ayeletperes/test-datasets fork.
    input = 'https://raw.githubusercontent.com/ayeletperes/test-datasets/airrflow/testdata-genotyping/test_genotyping_mixed_metadata.tsv'
    reference_fasta = params.pipelines_testdata_base_path + 'database-cache/imgtdb_base.zip'
    reference_igblast = params.pipelines_testdata_base_path + 'database-cache/igblast_base.zip'

    // Genotyping
    genotyping = true
    // Novel-allele inference is IG-only and orthogonal to the mixed-locus grouping
    // under test; disable it so the run exercises the genotype/reassign path directly.
    novel_allele_inference = false
    single_clone_representative = true
    clonal_threshold = 0.1
    skip_report_threshold = true
}
